# Normalize line endings: stored as LF in the repository.
* text=auto eol=lf

# C# and .NET project/build files
*.cs        text eol=lf diff=csharp
*.csx       text eol=lf diff=csharp
*.razor     text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.slnx      text eol=lf
*.config    text eol=lf
*.resx      text eol=lf
*.editorconfig text eol=lf

# Classic .sln files are expected to use CRLF by Visual Studio
*.sln       text eol=crlf

# Data and configuration
*.json      text eol=lf
*.xml       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sql       text eol=lf
*.http      text eol=lf

# Documentation
*.md        text eol=lf diff=markdown
*.txt       text eol=lf

# Scripts
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.psd1      text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.sh        text eol=lf

# Docker
Dockerfile  text eol=lf
*.dockerfile text eol=lf
.dockerignore text eol=lf

# Binary files
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.dll       binary
*.exe       binary
*.pfx       binary
*.snk       binary
