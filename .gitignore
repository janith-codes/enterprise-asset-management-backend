# .NET build output
**/bin/
**/obj/
artifacts/
*.binlog

# Visual Studio
.vs/
*.user
*.suo
*.userprefs

# JetBrains Rider
.idea/
*.DotSettings.user

# VS Code (shared workspace settings are committed; personal files are not)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# NuGet
*.nupkg
*.snupkg
.nuget/

# Environment and secrets
# Non-secret configuration (appsettings.json, appsettings.Development.json) IS committed.
# Secrets belong in `dotnet user-secrets` locally and in a secret store elsewhere.
.env
.env.*
!.env.example
secrets.json
appsettings.Local.json
appsettings.*.Local.json
*.pfx
*.p12
*.key
!*.key.example

# Logs
*.log
logs/

# Test results and coverage
TestResults/
coverage/
coverage*.xml
coverage*.json
*.coverage
*.coveragexml
*.trx
*.received.*

# Node.js
node_modules/
dist/
.next/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Docker local data
docker-data/
