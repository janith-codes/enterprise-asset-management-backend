<Project>

  <!--
    Central Package Management (comparable to Maven <dependencyManagement> / a BOM).
    Every package version is declared here once; project files reference packages
    without a Version attribute.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Transitive dependencies also use the versions pinned here, which helps when patching vulnerable transitive packages. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Package versions are added here, milestone by milestone, after approval. -->

  <!-- ASP.NET Core: keep aligned with the installed ASP.NET Core 10 runtime patch. -->
  <!-- Microsoft.Extensions abstractions used by non-web projects (module Infrastructure). -->
  <ItemGroup Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.21.0" />
  </ItemGroup>

  <!-- Tests run on Microsoft.Testing.Platform (opted in via global.json), so VSTest packages are not needed. -->
  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
